<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/printer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/printer_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/pixelify_sans"
            android:singleLine="true"
            android:text="P1S"
            android:textColor="#FFF2EFE6"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/printer_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixelify_sans"
            android:singleLine="true"
            android:text="Druckt"
            android:textColor="#FFFF8A3D"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/printer_job"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/pixelify_sans"
        android:singleLine="true"
        android:text="3DBenchy"
        android:textColor="#FF8C8AA8"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/printer_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="42"
        android:progressDrawable="@drawable/widget_progress" />

    <TextView
        android:id="@+id/printer_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/pixelify_sans"
        android:singleLine="true"
        android:text="42 % · noch 1 h 05 min · fertig ~15:40"
        android:textColor="#FFF2EFE6"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/printer_temps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/pixelify_sans"
            android:singleLine="true"
            android:text="Düse 220° · Bett 60°"
            android:textColor="#FF8C8AA8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/printer_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixelify_sans"
            android:singleLine="true"
            android:text="Stand 14:32"
            android:textColor="#FF8C8AA8"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
