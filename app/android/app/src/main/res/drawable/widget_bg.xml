<?xml version="1.0" encoding="utf-8"?>
<!-- Pixel panel: dark outline and a hard shadow offset to the bottom right, no rounded corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle"><solid android:color="#FF0D0D18" /></shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><solid android:color="#FF0D0D18" /></shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle"><solid android:color="#FF2A2A48" /></shape>
    </item>
</layer-list>
